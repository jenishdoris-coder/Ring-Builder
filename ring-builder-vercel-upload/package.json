{
  "name": "diamond-ring-renderer",
  "version": "1.0.0",
  "description": "Photorealistic Three.js diamond ring head renderer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "node scripts/build.mjs",
    "test:animation": "node scripts/testRingDissolve.mjs && node scripts/testRingAssembly.mjs",
    "test:gallery": "node scripts/testRingPreview.mjs",
    "preview": "vite preview",
    "cloud:check": "node scripts/cloud-preflight.mjs",
    "cloud:sync": "node scripts/cloud-sync.mjs",
    "check": "tsc --noEmit",
    "prepare:vercel": "node scripts/prepare-vercel-upload.mjs",
    "test:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lottie-react": "^2.4.1",
    "mongodb": "^7.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.160.0",
    "webgi": "https://storage.googleapis.com/dist.pixotronics.com/webgi/runtime/bundle-0.9.13.tgz"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webgi": "https://storage.googleapis.com/dist.pixotronics.com/webgi/runtime/bundle-types-0.9.13.tgz",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.11"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
