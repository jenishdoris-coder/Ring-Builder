# Vercel runtime (server-side only)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
MONGODB_DB=ring-builder-saanvi

# Local asset publishing: npm run cloud:sync
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=https://YOUR_PUBLIC_ASSET_HOST

# Store admin (server-side only): npm run admin:setup
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Exact origins allowed to upload through signed URLs: npm run admin:cors
ADMIN_UPLOAD_ORIGINS=http://localhost:5173,http://192.168.29.44:5173

# Optional DNS resolvers for local SRV lookup issues; normally omitted on Vercel
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
